// Firebase Firestore Security Rules - FIXED VERSION
// Copy paste ini ke Firebase Console > Firestore Database > Rules

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - FIXED: Allow service account and user self-access
    match /users/{userId} {
      // Service account can create/write (for admin panel)
      allow create, write: if request.auth == null || 
        (request.auth != null && request.auth.uid == userId);
      
      // Authenticated users can read their own doc
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Admins can read all users (after they have admin role)
      allow read: if request.auth != null && 
        request.auth.uid != userId && // not their own doc
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Bookings collection rules
    match /bookings/{bookingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Booking Slots collection rules
    match /booking_slots/{slotId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Facilities collection rules
    match /facilities/{facilityId} {
      allow read: if request.auth != null;
      allow write: if request.auth == null || // Service account
        (request.auth != null && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    
    // Classes/Schedules collection rules
    match /classes/{classId} {
      allow read: if request.auth != null;
      allow write: if request.auth == null || // Service account
        (request.auth != null && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
        
      match /members/{memberId} {
        allow read: if request.auth != null;
        allow write: if request.auth == null || // Service account
          (request.auth != null && 
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      }
    }
    
    // Employees collection rules
    match /employees/{employeeId} {
      allow read: if request.auth != null;
      allow write: if request.auth == null || // Service account
        (request.auth != null && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Employee Schedules collection rules
    match /employee_schedules/{scheduleId} {
      allow read: if request.auth != null;
      allow write: if request.auth == null || // Service account
        (request.auth != null && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    
    // Settings collection rules
    match /settings/{settingsId} {
      allow read: if request.auth != null;
      allow write: if request.auth == null || // Service account
        (request.auth != null && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    
    // Attendance collection rules
    match /attendance/{attendanceId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    // Attendances collection rules (web Manage Absen)
    match /attendances/{attendanceId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth == null || // Service account
        (request.auth != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Attendances archive (admin only)
    match /attendances_archive/{archiveId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth == null || // Service account
        (request.auth != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // KPI assessments (admin only)
    match /kpi_assessments/{assessmentId} {
      allow read, create, update, delete: if request.auth == null || // Service account
        (request.auth != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Bookings archive
    match /bookings_archive/{archiveId} {
      allow read, write: if request.auth != null;
    }

    // Reviews collection
    match /reviews/{reviewId} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth == null || // Service account
        (request.auth != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    
    // GSC Packages collection
    match /gsc_packages/{packageId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      // Allow users to create their own packages
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Allow user or admin to update
      allow update: if request.auth != null;
    }
    
    // Financial Transactions collection
    match /financial_transactions/{transactionId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Calorie History collection (scan kalori)
    match /calorie_history/{recordId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth == null || // Service account
        (request.auth != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    
    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
