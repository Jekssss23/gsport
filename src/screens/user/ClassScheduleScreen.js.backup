    color: theme.colors.text,
  },
  selectedCategoryItemText: {
    color: 'white',
  },
  classesList: {
    paddingBottom: 20,
  },
  classCard: {
    backgroundColor: theme.colors.surface,
    borderRadius: 12,
    padding: 16,
    marginBottom: 16,
    borderWidth: 1,
    borderColor: theme.colors.border,
  },
  classHeader: {
