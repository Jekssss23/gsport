{
  "expo": {
    "name": "GSC",
    "slug": "GSC",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/LOGO/LOGO GSPORT (ABU-ABU).png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/LOGO/LOGO GSPORT (ABU-ABU).png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/LOGO/LOGO GSPORT (ABU-ABU).png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "G.Sports.Center"
    },
    "web": {
      "favicon": "./assets/LOGO/LOGO GSPORT (ABU-ABU).png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/LOGO/LOGO GSPORT (ABU-ABU).png",
          "color": "#E31E24",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Aplikasi membutuhkan kamera untuk memindai QR absensi kelas."
        }
      ]
    ],
    "notification": {
      "icon": "./assets/LOGO/LOGO GSPORT (ABU-ABU).png",
      "color": "#E31E24",
      "androidMode": "default",
      "androidCollapsedTitle": "G Sports Center"
    },
    "extra": {
      "eas": {
        "projectId": "269e6350-dc6c-4096-ad18-a81585aa5135"
      }
    }
  }
}
