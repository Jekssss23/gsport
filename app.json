{
  "expo": {
    "name": "GSC",
    "slug": "GSC",
    "scheme": "gsc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/LOGO/ICON APP.jpeg",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/LOGO/LOGO GSPORT (ABU-ABU).png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gsportscenter.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "localhost": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            },
            "10.0.2.2": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            },
            "192.168.1.x": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/LOGO/ICON APP.jpeg",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.gsportscenter.app"
    },
    "web": {
      "favicon": "./assets/LOGO/ICON APP.jpeg"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/LOGO/ICON APP.jpeg",
          "color": "#E31E24",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Aplikasi membutuhkan kamera untuk memindai QR absensi kelas."
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.253539109830-e2bq76gq9jh10e51b06upf84tv8blkbj"
        }
      ]
    ],
    "notification": {
      "icon": "./assets/LOGO/ICON APP.jpeg",
      "color": "#E31E24",
      "androidMode": "default",
      "androidCollapsedTitle": "G Sports Center"
    },
    "extra": {
      "eas": {
        "projectId": "439d4ceb-cfc4-4e47-b66a-2dffa3677bd7"
      }
    },
    "owner": "rbsoftware"
  }
}
